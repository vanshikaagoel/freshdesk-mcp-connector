# Copy this file to .env and fill in real values. Never commit .env.

# Set to true to run against built-in synthetic tickets (no Freshdesk account needed).
FRESHDESK_MOCK=false

# Your Freshdesk subdomain, e.g. "acme" or "acme.freshdesk.com".
# Custom domains (CNAMEs) are not supported by the Freshdesk API.
FRESHDESK_DOMAIN=your-subdomain

# API key of a dedicated, least-privileged Freshdesk agent.
# Freshdesk API keys inherit that agent's full permissions; this connector
# enforces read-only access itself by only issuing GET requests.
FRESHDESK_API_KEY=your-api-key

# Optional tuning (defaults shown).
# FRESHDESK_TIMEOUT_MS=15000
# FRESHDESK_MAX_RETRIES=2
# FRESHDESK_MAX_RETRY_WAIT_MS=30000
# LOG_LEVEL=info
